# === FreshRSS + PostgreSQL ===
POSTGRES_DB=freshrss
POSTGRES_USER=freshrss
POSTGRES_PASSWORD=CHANGEME_use_a_real_password

FRESHRSS_PORT=8080
# FreshRSS username (tables are prefixed with it) and the URL people open FreshRSS at
FRESHRSS_API_USER=shawn
FRESHRSS_PUBLIC_URL=http://freshrss.yuffie.ts.net:8080

# === Anthropic API (scoring, summaries, briefs, chat) ===
ANTHROPIC_API_KEY=sk-ant-CHANGEME

# === Assistant service ===
ASSISTANT_PORT=8081
# Password for the assistant web UI (leave empty to disable auth; only do that on a private network)
ASSISTANT_PASSWORD=CHANGEME
# Shared secret between the FreshRSS extension and the assistant service (any long random string)
ASSISTANT_INTERNAL_TOKEN=CHANGEME_long_random_string
# URL the FreshRSS extension links to for "Open assistant"
ASSISTANT_PUBLIC_URL=http://freshrss.yuffie.ts.net:8081

# === Brief emails (optional, Fastmail SMTP) ===
DIGEST_SMTP_HOST=smtp.fastmail.com
DIGEST_SMTP_PORT=587
DIGEST_SMTP_USER=you@example.com
DIGEST_SMTP_PASSWORD=your_fastmail_app_password
DIGEST_TO_EMAIL=you@example.com
